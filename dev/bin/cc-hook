#!/usr/bin/env bash
# cc-hook: forward one Claude Code hook event (JSON on stdin) to the cc-sidebar app on the
# Windows host, and print the app's response so blocking events can return a decision.
# WSL runs in NAT mode, so the app is reached via the Windows host IP (the default route).
# Never fails the hook: any error (app down, timeout) means exit 0 with no output. After a
# failed connect it skips sending for 15 s, so a missing app costs Claude Code nothing.
# Usage (in hook config): cc-hook [max-seconds]
# Kill switch: `touch ~/.config/cc-sidebar/off` disables every hook instantly.
if [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/cc-sidebar/off" ]; then
  cat >/dev/null
  exit 0
fi
max="${1:-3}"
port="${CC_SIDEBAR_PORT:-47821}"
down="${XDG_RUNTIME_DIR:-/tmp}/cc-sidebar-down-$(id -u)"
if [ -f "$down" ] && [ $(( $(date +%s) - $(stat -c %Y "$down" 2>/dev/null || echo 0) )) -lt 15 ]; then
  cat >/dev/null
  exit 0
fi
host="${CC_SIDEBAR_HOST:-$(ip route show default 2>/dev/null | awk '{print $3; exit}')}"
[ -n "$host" ] || exit 0
out=$(curl -s --fail --connect-timeout 0.3 --max-time "$max" \
  -H 'Content-Type: application/json' \
  -H "X-CC-Tag: ${CC_SIDEBAR_TAG:-}" \
  -H "X-CC-Pid: ${CC_SIDEBAR_PID:-}" \
  -H "X-WT-Session: ${WT_SESSION:-}" \
  -H "X-CC-Internal: ${CC_SIDEBAR_INTERNAL:-}" \
  -H "X-WSL-Distro: ${WSL_DISTRO_NAME:-}" \
  --data-binary @- "http://$host:$port/hook")
rc=$?
# 7 = couldn't connect, 28 = connect timed out: the app isn't there.
if [ $rc -eq 7 ] || { [ $rc -eq 28 ] && [ -z "$out" ]; }; then
  : >"$down"
fi
[ $rc -eq 0 ] && [ -n "$out" ] && printf '%s\n' "$out"
exit 0
